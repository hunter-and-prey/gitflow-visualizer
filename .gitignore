# ==========================================================================
# GitFlow Visualizer - .gitignore Configurations
# ==========================================================================

# --- Operating System Temp Files ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
*~
.fuse_hidden*
.directory
.trash/
.nfs*

# --- Editor and IDE Specifics ---
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/bias.json
*.code-workspace
.history/

# IntelliJ / WebStorm
.idea/
*.iws
*.iml
*.ipr

# Vim & Sublime Text
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- Local Logs and Node (for future scaling) ---
node_modules/
jspm_packages/
web_folders/
dist/
tmp/
out/
build/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment Variables ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.backup
*.env
